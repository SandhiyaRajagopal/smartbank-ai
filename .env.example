# ---- LLM (Google Gemini) ----
# Option A (local dev): AI Studio API key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# Option B (GCP / production): Vertex AI, authenticated by your gcloud login or the
# Cloud Run service account - no API key needed. Set USE_VERTEXAI=true and your project id.
USE_VERTEXAI=false
GCP_PROJECT=
GCP_LOCATION=global
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ---- LangSmith tracing (https://smith.langchain.com) ----
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=smartbank-ai

# ---- App ----
# Signs login tokens. Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# (leave empty for a random secret on every start - you will need to log in again after restarts)
JWT_SECRET=
DATABASE_URL=sqlite:///./data/smartbank.db
# seconds between simulated live transactions
SIMULATOR_INTERVAL=20
